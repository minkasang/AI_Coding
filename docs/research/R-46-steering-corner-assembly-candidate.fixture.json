  "newRelation": {
    "id": "R46-REL-01",
    "rule": "允许每角子总成实例（corner=FL|FR）挂在 VEH 级父总成实例下，条件是：子总成显式声明其角位、其全部子件的角位与子总成实例角位一致、且每个子件在整车数量上只被这两侧各计一次。",
    "whyNeeded": "中央转向器必须保持一个 VEH 级实例（总控已定），而内外拉杆/锁紧件/保护件天然是左右各一件。现有对角规则只约束『零件角位 == 直接父总成实例角位』，不约束『总成实例角位 == 其父总成实例角位』。",
    "doesNotBreakExistingGuards": {
      "checked": [
        "tools/r16_skeleton_tool.py",
        "tools/r21_mapping_tool.py",
        "tools/r42_identity_tool.py"
      ],
      "finding": "三个校验器均未断言『总成实例角位 == 父总成实例角位』；对角规则只作用于零件实例与其直接父总成实例。",
      "newRelationIsAdditive": true
    },
    "alternativeRejected": "放宽『零件角位可以细于父总成实例』（R-42 的 OPT-42-B）会直接改动对角规则、影响全部 278 个零件实例的校验；本候选不动那条规则。"
  },
